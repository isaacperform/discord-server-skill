    "tester": { "name": "🧪 베타테스터", "color": "#7E82DF", "hoist": true }
  },
  "categories": [
    {
      "key": "start",
      "name": "📌 시작",
      "channels": [
        { "key": "welcome", "name": "👋환영-시작하기", "type": "text", "readonly": true, "topic": "처음 오셨다면 아래 안내부터 읽어 주세요." },
        { "key": "notice", "name": "📣공지", "type": "announcement", "readonly": true, "topic": "베타 일정·점검·설문처럼 꼭 봐야 하는 것만 올려요." }
      ]
    },
    {
      "key": "beta",
      "name": "🧪 베타",
      "visibleTo": ["tester"],
      "channels": [
        { "key": "updates", "name": "🚀업데이트-로그", "type": "announcement", "readonly": true, "topic": "배포될 때마다 바뀐 점을 올려요. 제보해 주신 버그가 고쳐지면 여기서 이름을 불러 드려요." },
        {
          "key": "bugs",
          "name": "🐛버그-제보",
          "type": "forum",
          "reaction": "👍",
          "topic": "버그 하나 = 글 하나. 제목은 \"[화면] 증상\"으로 써 주세요. 예) [로그인] 버튼을 눌러도 반응이 없어요\n\n본문에는 세 가지만:\n1. 어디서 — 화면 이름, 주소\n2. 무엇을 했더니 — 누른 순서\n3. 무엇이 보였는지 — 캡처 한 장이면 최고예요\n\n같은 증상을 겪었다면 👍 를 눌러 주세요. 상태 태그(📥 접수 · 🔍 확인중 · ✅ 해결됨)는 운영진이 붙이고, 고쳐지면 이 글에 답을 남겨요.",
          "tags": [
            { "name": "설치" }, { "name": "연동" }, { "name": "화면" }, { "name": "데이터" }, { "name": "기타" },
            { "name": "접수", "emoji": "📥", "staffOnly": true },
            { "name": "확인중", "emoji": "🔍", "staffOnly": true },
            { "name": "해결됨", "emoji": "✅", "staffOnly": true },
            { "name": "재현안됨", "emoji": "❔", "staffOnly": true }
          ]
        },
        {
          "key": "ideas",
          "name": "💡기능-제안",
          "type": "forum",
          "reaction": "👍",
          "topic": "제안 하나 = 글 하나. \"무엇을 하려고 했는데 → 지금은 이게 불편하다\"로 써 주시면 가장 빨리 이해해요.\n\n다른 분 제안에 공감하면 👍 를 눌러 주세요. 👍 많은 것부터 검토해요.\n상태 태그(🔎 검토중 · 📅 예정 · ✅ 반영됨 · 💤 보류)는 운영진이 붙여요.",
          "tags": [
            { "name": "새 기능" }, { "name": "개선" }, { "name": "연동" }, { "name": "기타" },
            { "name": "검토중", "emoji": "🔎", "staffOnly": true },
            { "name": "예정", "emoji": "📅", "staffOnly": true },
            { "name": "반영됨", "emoji": "✅", "staffOnly": true },
            { "name": "보류", "emoji": "💤", "staffOnly": true }
          ]
        },
        {
          "key": "qna",
          "name": "❓질문-답변",
          "type": "forum",
          "topic": "쓰는 법·설치·계정 질문은 여기로. 비슷한 질문이 있는지 검색부터 해 보세요. 답이 쌓이면 그대로 FAQ가 돼요.\n해결되면 운영진이 ✅ 해결됨 태그를 붙여요.",
          "tags": [
            { "name": "설치" }, { "name": "사용법" }, { "name": "계정" }, { "name": "기타" },
            { "name": "해결됨", "emoji": "✅", "staffOnly": true }
          ]
        },
        { "key": "showcase", "name": "🙌사용-후기", "type": "text", "topic": "써 보니 좋았던 점, 이렇게 쓰고 있다는 이야기를 나눠 주세요. 캡처 환영!" },
        { "key": "lounge", "name": "💬잡담", "type": "text", "topic": "인사·잡담·아무 이야기." },
        { "key": "office", "name": "🎧오피스아워", "type": "voice" }
      ]
    },
    {
      "key": "ops",
      "name": "🛠️ 운영",
      "visibleTo": ["staff"],
      "channels": [
        { "key": "ops-log", "name": "🤖운영-로그", "type": "text", "topic": "운영진 전용. 봇 기록과 디스코드 커뮤니티 안내가 여기로 와요." }
      ]
    }
  ],
  "messages": [
    { "key": "welcome", "channel": "welcome", "file": "content/welcome.md" }
  ],
  "welcomeScreen": {
    "description": "클로즈베타에 오신 걸 환영해요. 써 보고 남겨 주시는 말이 그대로 제품이 돼요.",
    "channels": [
      { "channel": "welcome", "emoji": "👋", "description": "시작하는 법부터 보기" },
      { "channel": "bugs", "emoji": "🐛", "description": "오류·이상한 점 제보" },
      { "channel": "ideas", "emoji": "💡", "description": "있었으면 하는 기능" },
      { "channel": "qna", "emoji": "❓", "description": "쓰는 법 질문" },
      { "channel": "lounge", "emoji": "💬", "description": "가볍게 인사 한마디" }
    ]
  },
  "invite": { "channel": "welcome", "roles": ["tester"], "maxUses": 1, "days": 7 },
  "feedback": ["bugs", "ideas", "qna"]
}
